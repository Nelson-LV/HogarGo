    <string name="about_feature_tasks_title">Tareas y racha</string>
    <string name="about_feature_tasks_body">Reparte tareas, complétalas para ganar monedas y mantén tu racha diaria.</string>
    <string name="about_feature_finance_title">Finanzas</string>
    <string name="about_feature_finance_body">Registra gastos por categoría y crea varias metas de ahorro para la familia.</string>
    <string name="about_feature_pet_title">Mascota Zori</string>
    <string name="about_feature_pet_body">Aliméntalo, juega con él y compra decoraciones con tus monedas.</string>
    <string name="about_feature_calendar_title">Calendario</string>
    <string name="about_feature_calendar_body">Organiza eventos y no olvides las fechas de pago de tus cuentas.</string>
